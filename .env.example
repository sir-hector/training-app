# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.

# --- Sentry ---
# From your Sentry project settings → Client Keys (DSN).
# Public-safe (baked into the client bundle at build time).
NEXT_PUBLIC_SENTRY_DSN=

# Environment tag applied to Sentry events. Use "development" locally,
# "production" in the deployed app (already set in fly.toml).
NEXT_PUBLIC_APP_ENV=development

# --- Sentry (build-time source maps upload — optional locally) ---
# Only needed for source-map upload during `next build`. Local dev works
# without these; leave empty unless you're testing the upload pipeline.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=training-app

# --- Database (Neon Postgres) ---
# Local dev: use your own Neon branch's pooled connection string
# (Neon console → project → Branches → your branch → Connection string).
# CI creates a throwaway branch per PR and injects this automatically.
DATABASE_URL=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI, local:  http://localhost:3000/api/auth/callback/google
# Authorised redirect URI, prod:   https://training-app-hector.fly.dev/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required when running behind a proxy (Fly). Set to "true" in production;
# harmless locally.
AUTH_TRUST_HOST=true
